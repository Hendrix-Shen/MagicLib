root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
tab_width = 4

[*.java]
ij_continuation_indent_size = 8
ij_java_imports_layout = *,|,net.minecraft.**,|,top.hendrixshen.magiclib.**,|,java.**,javax.**,|,$*
ij_java_class_count_to_use_import_on_demand = 999
